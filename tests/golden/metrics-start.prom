# HELP kausa_incidents_total Incidents that settled, by detection.
# TYPE kausa_incidents_total counter
kausa_incidents_total 0
# HELP kausa_model_calls_total Calls to the model endpoint, by outcome (ok, error, invalid).
# TYPE kausa_model_calls_total counter
kausa_model_calls_total 0
# HELP kausa_model_tokens_total Tokens the endpoint reported, by direction (in, out).
# TYPE kausa_model_tokens_total counter
kausa_model_tokens_total 0
# HELP kausa_explanations_cached_total Incidents explained again from the deduplication cache.
# TYPE kausa_explanations_cached_total counter
kausa_explanations_cached_total 0
# HELP kausa_explanations_skipped_total Incidents not explained, by reason.
# TYPE kausa_explanations_skipped_total counter
kausa_explanations_skipped_total 0
# HELP kausa_explanations_retried_total Calls tried again after a transient error.
# TYPE kausa_explanations_retried_total counter
kausa_explanations_retried_total 0
# HELP kausa_explanations_dropped_total Incidents dropped because the explanation queue was full.
# TYPE kausa_explanations_dropped_total counter
kausa_explanations_dropped_total 0
# HELP kausa_requests_logged_total Requests logged instead of sent (--dry-run).
# TYPE kausa_requests_logged_total counter
kausa_requests_logged_total 0
# HELP kausa_redactions_total Values replaced by redaction in the requests, by rule.
# TYPE kausa_redactions_total counter
kausa_redactions_total 0
# HELP kausa_events_written_total Events created or updated, by reason.
# TYPE kausa_events_written_total counter
kausa_events_written_total{reason="Detected"} 0
# HELP kausa_event_write_errors_total Events that could not be written.
# TYPE kausa_event_write_errors_total counter
kausa_event_write_errors_total 0
# HELP kausa_watch_errors_total Errors of the Pod, Event and Deployment watches, which retry with backoff, by watch.
# TYPE kausa_watch_errors_total counter
kausa_watch_errors_total{watch="deployments"} 0
kausa_watch_errors_total{watch="events"} 0
kausa_watch_errors_total{watch="pods"} 0
# HELP kausa_history_writes_total Explanation objects written, by outcome (created, updated, refused, conflict, error).
# TYPE kausa_history_writes_total counter
kausa_history_writes_total 0
# HELP kausa_history_deleted_total Explanation objects deleted by the sweep, by reason (age, cap).
# TYPE kausa_history_deleted_total counter
kausa_history_deleted_total 0
# HELP kausa_history_sweep_errors_total Failed list or delete calls of the history sweep.
# TYPE kausa_history_sweep_errors_total counter
kausa_history_sweep_errors_total 0
# HELP kausa_notifications_total Notifications by final outcome (sent, failed, dropped, capped).
# TYPE kausa_notifications_total counter
kausa_notifications_total 0
# HELP kausa_notifications_retried_total Notifications tried again after a transient error.
# TYPE kausa_notifications_retried_total counter
kausa_notifications_retried_total 0
# HELP kausa_leadership_changes_total Times this process became leader or stepped down to standby, by `to` (leader, standby).
# TYPE kausa_leadership_changes_total counter
kausa_leadership_changes_total 0
# HELP kausa_lease_errors_total Failed calls on the Lease, by `call` (get, patch); conflicts are not errors.
# TYPE kausa_lease_errors_total counter
kausa_lease_errors_total 0
# HELP kausa_answer_redactions_total Values replaced by redaction in the model's answers, by rule.
# TYPE kausa_answer_redactions_total counter
kausa_answer_redactions_total 0
# HELP kausa_watch_relists_total Lists of the Pod, Event and Deployment watches after the first of each watch, by watch.
# TYPE kausa_watch_relists_total counter
kausa_watch_relists_total{watch="deployments"} 0
kausa_watch_relists_total{watch="events"} 0
kausa_watch_relists_total{watch="pods"} 0
# HELP kausa_watch_restarts_total New watchers started after the API server refused a watch (403), by watch.
# TYPE kausa_watch_restarts_total counter
kausa_watch_restarts_total{watch="deployments"} 0
kausa_watch_restarts_total{watch="events"} 0
kausa_watch_restarts_total{watch="pods"} 0
# HELP kausa_answers_withheld_total Model answers in which kausa replaced text with its withheld-command notice.
# TYPE kausa_answers_withheld_total counter
kausa_answers_withheld_total 0
# HELP kausa_facts_dropped_total Facts dropped because the fact queue was full.
# TYPE kausa_facts_dropped_total counter
kausa_facts_dropped_total 0
# HELP kausa_fact_reasons_omitted_total Fact statements that left out a reason outside the list of known reasons.
# TYPE kausa_fact_reasons_omitted_total counter
kausa_fact_reasons_omitted_total 0
# HELP kausa_leader 1 while this process acts (it holds the Lease, or runs without --leader-lease), 0 as a standby.
# TYPE kausa_leader gauge
kausa_leader 1
# HELP kausa_endpoint_state State of the model endpoint's breaker: 1 for the current state (closed, open, half_open), 0 for the others; closed on a standby.
# TYPE kausa_endpoint_state gauge
kausa_endpoint_state{state="closed"} 1
kausa_endpoint_state{state="half_open"} 0
kausa_endpoint_state{state="open"} 0
# HELP kausa_build_info Always 1; the labels name this build of kausa (version, prompt_version).
# TYPE kausa_build_info gauge
kausa_build_info{version="0.0.0-golden",prompt_version="0"} 1
# HELP kausa_records Records kausa holds, by kind (pods, events, deployments); 0 on a standby.
# TYPE kausa_records gauge
kausa_records{kind="deployments"} 0
kausa_records{kind="events"} 0
kausa_records{kind="pods"} 0
# HELP kausa_owner_cache_entries Owner lookups in the cache, expired ones included until the next lookup that reads the API server; 0 on a standby.
# TYPE kausa_owner_cache_entries gauge
kausa_owner_cache_entries 0
